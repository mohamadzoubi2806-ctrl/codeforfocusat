# Server-side only. Used by the Netlify function at netlify/functions/gemini.mts.
#
# This value must NEVER be prefixed with VITE_ and must never be imported from
# React code — anything Vite can see is inlined into the public browser bundle.
#
# Local development:  copy this file to .env (already git-ignored) and run `netlify dev`.
# Production:         set it in Netlify → Site configuration → Environment variables.

GEMINI_API_KEY=
